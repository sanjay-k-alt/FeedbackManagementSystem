
@model FeedbackManagementSystem.Models.Feedback

@{
    ViewBag.Title = "Feedback Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        font-family: Arial, sans-serif;
        background: #f4f6f9;
    }

    .feedback-container {
        max-width: 650px;
        margin: 40px auto;
        padding: 30px;
        background: white;
        border: 1px solid #ddd;
        border-radius: 10px;
    }

    .form-group {
        margin-bottom: 18px;
    }

    .form-control {
        width: 100%;
        padding: 10px;
        margin-top: 6px;
        box-sizing: border-box;
    }

    .text-danger {
        color: red;
    }

    .success-message {
        padding: 12px;
        color: #155724;
        background: #d4edda;
        margin-bottom: 20px;
    }

    button {
        padding: 10px 18px;
        cursor: pointer;
    }
</style>

<div class="feedback-container">
    <h2>Feedback Management</h2>
    <p>Please share your feedback with us.</p>

    @if (ViewBag.SuccessMessage != null)
    {
        <div class="success-message">
            @ViewBag.SuccessMessage
        </div>
    }

    @Html.Partial("_FeedbackForm", Model)
</div>
